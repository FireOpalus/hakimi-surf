# Optional official Node loader for the domestic protocol host.
# Copy this example to docker-compose.napcat.official-node.yml before use.
# docker compose --env-file .env.napcat -f docker-compose.napcat.yml \
#   -f docker-compose.napcat.official-node.yml up -d
services:
  napcat:
    image: ghcr.io/napneko/nodenapcat@sha256:43e600211bc1ab273e9b2fc68776359d6cfbf03f99ba0f7cf52f3c99add51316
    pull_policy: missing
    user: '10001:10001'
    hostname: hakimi-napcat-shanghai
    working_dir: /app
    entrypoint: ['node', '/app/load.cjs']
    environment: !override
      TZ: Asia/Shanghai
      HOME: /app
      NAPCAT_WORKDIR: /app/napcat-state
    volumes: !override
      - ./data/napcat-shanghai/qq:/app/.config/QQ
      - ./data/napcat-shanghai/state:/app/napcat-state
    read_only: true
    cap_drop: [ALL]
    security_opt: ['no-new-privileges:true']
    tmpfs: ['/tmp:size=256m,mode=1777']

  # Optional transparent OneBot voice-to-text edge relay (uses native NapCat fetch_ptt_text).
  # Build locally: docker build -t hakimi-napcat-voice-relay:v1 ../legacy/napcat_voice_relay
  # napcat-voice-relay:
  #   image: hakimi-napcat-voice-relay:v1
  #   pull_policy: never
  #   env_file:
  #     - .env.napcat
  #   environment:
  #     TZ: Asia/Shanghai
  #     RELAY_LISTEN_HOST: "0.0.0.0"
  #     RELAY_LISTEN_PORT: "3001"
  #   expose:
  #     - "3001"
  #   read_only: true
  #   cap_drop: [ALL]
  #   security_opt: ['no-new-privileges:true']
  #   init: true
  #   mem_limit: 64m
  #   pids_limit: 32
  #   restart: unless-stopped
