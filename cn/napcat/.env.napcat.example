# Domestic node only: never copy the offshore Gemini/Drive/encryption credentials here.
TZ=Asia/Shanghai
ONEBOT_URL=wss://qq.example.com/ws/onebot/REPLACE_WITH_48_RANDOM_HEX_CHARS
NAPCAT_WEBUI_TOKEN=GENERATE_WITH_PYTHON_SECRETS_TOKEN_URLSAFE_32
NAPCAT_UID=1000
NAPCAT_GID=1000
# Put the offshore ONEBOT_ACCESS_TOKEN in onebot11_<QQ>.json's token field.
# This file is used with: docker compose --env-file .env.napcat -f docker-compose.napcat.yml ...

# For the official Node loader, copy docker-compose.napcat.official-node.yml.example
# to the ignored local file docker-compose.napcat.official-node.yml.
# It fixes UID:GID=10001:10001 and NAPCAT_WORKDIR=/app/napcat-state;
# place its configuration under data/napcat-shanghai/state/config/.
# It reuses the same ONEBOT_URL/WebUI token; no new secrets are required.

# Optional transparent Shanghai-side voice-to-text relay (napcat-voice-relay):
# Keep UPSTREAM_ONEBOT_URL pointed at the offshore WSS URL, and point onebot11_<QQ>.json
# websocketClients[0].url at ws://napcat-voice-relay:3001.
UPSTREAM_ONEBOT_URL=wss://qq.example.com/ws/onebot/REPLACE_WITH_48_RANDOM_HEX_CHARS
VOICE_STT_ENABLED=true
VOICE_STT_SCOPE=all
# VOICE_STT_ALLOWED_GROUPS=
# VOICE_STT_IGNORED_GROUPS=
