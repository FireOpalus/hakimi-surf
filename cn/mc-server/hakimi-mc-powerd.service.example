[Unit]
Description=Hakimi Minecraft Restricted Power Daemon (mc-powerd)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/hakimi-mc-server
EnvironmentFile=/opt/hakimi-mc-server/.env.powerd
ExecStart=/usr/bin/python3 -u /opt/hakimi-mc-server/mc-powerd.py
Restart=always
RestartSec=3
OOMScoreAdjust=-200
NoNewPrivileges=false
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
