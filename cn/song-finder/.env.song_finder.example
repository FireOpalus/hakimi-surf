# Copy to /opt/hakimi-song-finder/.env.song_finder (chmod 600) on the CN host.
# Issue the plugin token in the offshore /admin panel and lock X-Plugin-ID + source IP on Nginx.

HAKIMI_PLUGIN_WS_URL=wss://your-domain.example/ws/plugin
HAKIMI_PLUGIN_SONG_FINDER_TOKEN=REPLACE_WITH_SONG_FINDER_PLUGIN_TOKEN
SONG_FINDER_PROVIDER_ORDER=bilibili,netease
SONG_FINDER_NODE_REGION=CN
TZ=Asia/Shanghai
