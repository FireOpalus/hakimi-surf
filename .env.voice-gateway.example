# Standalone KR universal audio gateway (hakimi-voice-gateway).
# Copy to ./secrets/voice-gateway.env (chmod 600, never commit) before starting Compose.

# Gateway server listener and auth (generate strong random values locally):
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
# python -c 'import secrets; print("/ws/voice/" + secrets.token_hex(24))'
VOICE_GATEWAY_HOST=0.0.0.0
VOICE_GATEWAY_PORT=12145
VOICE_GATEWAY_WS_PATH=/ws/voice/REPLACE_WITH_48_RANDOM_HEX_CHARS
VOICE_GATEWAY_TOKEN=GENERATE_WITH_PYTHON_SECRETS_TOKEN_URLSAFE_32
VOICE_GATEWAY_MAX_AUDIO_BYTES=10485760
VOICE_GATEWAY_MAX_WS_FRAME_BYTES=16777216
VOICE_GATEWAY_DEFAULT_OUTPUT_FORMAT=mp3

# Upstream /ws/companion connection (use internal Compose service name on KR):
COMPANION_WS_URL=ws://hakimi-bot:12141/ws/companion/REPLACE_WITH_COMPANION_SECRET_PATH
COMPANION_WS_TOKEN=REPLACE_WITH_COMPANION_WS_TOKEN
COMPANION_ADAPTER_ID=voice-gateway
COMPANION_CLIENT_ID=default
COMPANION_MODE=owner_private
COMPANION_GAME_TITLE=
COMPANION_SPEAKER_ID=owner
COMPANION_SPEAKER_NAME=BOISER
PING_INTERVAL_SECONDS=20.0

# STT / TTS provider selection (siliconflow | fish | openai for STT; siliconflow | fish | breezeblue | edge for TTS):
STT_PROVIDER=siliconflow
TTS_PROVIDER=siliconflow

# SiliconFlow (default):
SILICONFLOW_API_KEY=REPLACE_WITH_SILICONFLOW_API_KEY
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_STT_MODEL=FunAudioLLM/SenseVoiceSmall
SILICONFLOW_TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
SILICONFLOW_TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:diana
TTS_SPEED=1.05
TTS_GAIN=0.0
TTS_FORMAT=mp3
TTS_BUFFER_MODE=turn
TTS_STREAMING=true

# Optional Fish Audio:
FISH_API_KEY=
FISH_BASE_URL=https://api.fish.audio
FISH_REFERENCE_ID=
FISH_MODEL=
FISH_LATENCY=balanced
FISH_ASR_LANGUAGE=zh
FISH_ASR_MODEL=

# Optional BreezeBlue (Breeze TTS 2):
BREEZEBLUE_API_KEY=
BREEZEBLUE_BASE_URL=https://api.breeze.blue
BREEZEBLUE_VOICE_ID=
BREEZEBLUE_MODEL_ID=breeze-tts-2
BREEZEBLUE_LANGUAGE_CODE=zh
BREEZEBLUE_INSTRUCTIONS=
BREEZEBLUE_GUIDANCE_SCALE=
BREEZEBLUE_SPEAKER_BOOST=

# Optional OpenAI-compatible STT (e.g. Groq Whisper) & Edge TTS fallback:
OPENAI_STT_API_KEY=
OPENAI_STT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_STT_MODEL=whisper-large-v3-turbo
EDGE_TTS_VOICE=zh-CN-XiaoyiNeural
