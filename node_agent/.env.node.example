# Copy to .env.node (chmod 600) on tencent-cloud-CN before launching compose.cn.yaml.
# Keep NODE_WS_URL path and NODE_WS_TOKEN synchronized with KR .env and nginx hakimi-ws.conf.

NODE_WS_URL=wss://qq.example.com/ws/node/REPLACE_WITH_48_RANDOM_HEX_CHARS
NODE_WS_TOKEN=GENERATE_32+_CHAR_RANDOM_SECRET_TOKEN_BEFORE_ENABLE
NODE_ID=shanghai-cn-1
NODE_REGION=CN
WS_PING_INTERVAL=25.0
WS_PING_TIMEOUT=30.0
RECONNECT_MAX=30.0
MAX_FRAME_BYTES=1048576
BILI_MIN_INTERVAL=1.2
NODE_TEMP_DIR=/tmp/node_bili_jobs

# Phase 4 local Mineflayer sidecar bridge (internal Docker network hakimi_cn_net only)
MC_BRIDGE_ENABLED=false
MC_BRIDGE_URL=ws://hakimi-mc-agent:8791/ws
MC_BRIDGE_TOKEN=GENERATE_32+_CHAR_RANDOM_MC_BRIDGE_TOKEN_BEFORE_ENABLE
MC_RPC_TIMEOUT=15.0
