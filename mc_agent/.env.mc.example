# Copy to .env.mc (chmod 600) on tencent-cloud-CN alongside compose.cn.yaml.
# Keep MC_BRIDGE_TOKEN synchronized with .env.node on tencent-cloud-CN.

MC_BRIDGE_HOST=0.0.0.0
MC_BRIDGE_PORT=8791
MC_BRIDGE_TOKEN=GENERATE_32+_CHAR_RANDOM_SECRET_TOKEN_BEFORE_ENABLE

# Set MC_ENABLED=true and MC_HOST/MC_PORT when a Minecraft server is ready.
# When MC_ENABLED=false or MC_HOST is empty, the sidecar runs in standby mode.
MC_ENABLED=false
MC_HOST=
MC_PORT=25565
MC_USERNAME=HakimiBot
MC_AUTH=offline
MC_VERSION=
MC_VIEW_DISTANCE=4
MC_ALLOWED_PLAYERS=
MC_ALLOW_CHAT=false
MC_IDLE_DISCONNECT_MINUTES=20
MC_SOLO_MAX_MINUTES=90
