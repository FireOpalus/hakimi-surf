# Run scripts/init_env.py to create a private .env with random local keys.
# Never commit .env. JSON arrays are required for ID lists. QQ OpenID is not a QQ number.
HAKIMI_NAMESPACE=home
HAKIMI_GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
# Decisions 单次请求超时（秒，1–30）。视频审核单独使用 60 秒。
HAKIMI_DECISION_TIMEOUT=20
HAKIMI_ENCRYPTION_KEY=GENERATE_WITH_INIT_ENV
HAKIMI_DATA_DIR=data

# /admin is entirely disabled (403) unless a nonempty token is configured.
# Use a long random password. Browser stores it in memory only; never in URL/localStorage.
ADMIN_TOKEN=
# Open through: ssh -N -L 12141:127.0.0.1:12143 user@server
# Then visit http://127.0.0.1:12141/admin (localhost also allowed).

# Rolling summary <=800 chars; user + assistant count as TWO messages.
# Env is read at startup. /admin -> 群聊与记忆 can override these live and persist to SQLite.
# Use "恢复 .env 配置" to remove that override; editing .env itself requires a restart.
HAKIMI_COMPRESSION_ENABLED=true
# Count rules below apply only to explicit legacy mode; keep applies to manual compression.
HAKIMI_GROUP_COMPRESSION_MESSAGES=60
HAKIMI_GROUP_COMPRESSION_CHARS=6000
HAKIMI_GROUP_COMPRESSION_KEEP=25
# Count-only compression is deferred while chars <1200 AND messages <90.
HAKIMI_GROUP_COMPRESSION_MIN_CHARS=1200
HAKIMI_GROUP_COMPRESSION_MAX_MESSAGES=90
HAKIMI_PRIVATE_COMPRESSION_MESSAGES=40
HAKIMI_PRIVATE_COMPRESSION_CHARS=6000
HAKIMI_PRIVATE_COMPRESSION_KEEP=16
HAKIMI_SUMMARY_TTL_SECONDS=604800
HAKIMI_MEMORY_DAILY_USD=0.20
HAKIMI_ADMIN_DAILY_USD=0.20

# Owner-only snapshot; disabled by default. Never used by groups, diaries or sandbox.
ENABLE_NOTEBOOK_SNAPSHOT=false
GDRIVE_NOTEBOOK_SNAPSHOT_FILE_ID=
NOTEBOOK_SNAPSHOT_PATH=./data/owner_notebook_snapshot.md
# If FILE_ID is set: read ONLY that file every 6 hours, using the configured Service Account.
# Share ONLY the sanitized snapshot with Viewer permission; no folder/main-memory access.
# Cloud mode never writes Drive or falls back silently on errors. Cached data stays in memory.
# If FILE_ID is blank: local file source, editable through authenticated /admin (<=4000 chars).
# Optional read-only Antigravity_Memory mount for Owner private chats only:
ENABLE_ANTIGRAVITY_MEMORY=false
ANTIGRAVITY_MEMORY_DIR=/run/antigravity-memory

HAKIMI_ONEBOT_ENABLED=true
HAKIMI_ONEBOT_SELF_ID=123456789
HAKIMI_ONEBOT_SECRET=GENERATE_WITH_INIT_ENV
HAKIMI_ONEBOT_ACCESS_TOKEN=GENERATE_WITH_INIT_ENV
HAKIMI_ONEBOT_API_BASE=http://127.0.0.1:3000
# Legacy compatibility only; this list does not grant management or Owner permissions.
HAKIMI_ONEBOT_OWNER_IDS=[]
HAKIMI_ONEBOT_ALLOWED_USERS=[]
HAKIMI_ONEBOT_ALLOWED_GROUPS=[]
# /admin -> 准入与防互刷名单 saves hot SQLite overrides; reset restores these env values.
# An empty group allowlist denies ALL groups. Owner private access is always retained.
# owner_only | owner_and_allowlist; allowed friends always use PUBLIC persona + own session.
HAKIMI_ONEBOT_PRIVATE_MODE=owner_only
# The ONLY QQ ID eligible for the private persona and public OWNER marker.
# Blank -> public persona for everyone and no QQ chat management permissions.
# Official QQ OpenIDs do not identify the owner of this numeric OneBot account.
OWNER_QQ_ID=
# Owner-only proactive DMs. /admin -> 主动私信 saves live overrides in SQLite.
# Additional installed chat plugins can bind an authenticated bot account and user ID.
# Notebook access and inclusion in the Owner mirror are independent, opt-in grants.
HAKIMI_SOCIAL_OWNER_BINDINGS={}
# One delivery destination for Owner alerts and the daily digest. The default uses OWNER_QQ_ID.
HAKIMI_OWNER_DELIVERY_PLATFORM=onebot
# Times below are interpreted in BOT_TIMEZONE.
BOT_TIMEZONE=Asia/Shanghai
REST_HOURS_ENABLED=true
REST_HOURS=23:00-08:00
DAY_REST_ENABLED=true
REST_ALLOW_OWNER_PRIVATE=false
# 世界引擎的 Owner 投递许可与主动免打扰时段（可在 /admin 世界引擎中覆盖）
PROACTIVE_DM_ENABLED=true
# Optional exemptions from the world engine's shared activity count.
HAKIMI_LIFE_ENGINE_OWNER_DMS_UNLIMITED=false
HAKIMI_LIFE_ENGINE_BILI_PATROLS_UNLIMITED=false
QUIET_HOURS=23:30-08:30
# Paid proactive work is also subject to all existing global/user budgets.
HAKIMI_PROACTIVE_DAILY_USD=0.10
HAKIMI_PROACTIVE_ALERT_COOLDOWN_SECONDS=21600
HAKIMI_PROACTIVE_WS_ALERT_AFTER_SECONDS=300
# Optional daily signature, returned by the SAME digest model call; manual controls are separate.
# Auto changes require at least 20 hours between attempts; never exposed as a model tool.
ENABLE_DAILY_LONGNICK=false
LONGNICK_COOLDOWN_HOURS=20
# Local cumulative cost limit, NOT the Google account credit balance. 0 disables this cap.
# Existing retained ledger rows seed the counter; historical pruned rows cannot be recovered.
HAKIMI_TOTAL_USD=40.00
# Known external bots: unconditionally ignored before any paid call; /admin can update live.
# Example: ["345678901","456789012"]. Exclude OWNER_QQ_ID and ONEBOT_SELF_ID.
# IGNORED_BOT_QQ_IDS is a compatibility alias; use one name only.
BOT_QQ_IDS=[]
# 已知外部 Bot 的 should_reply 门槛；1.00 在入站前完全屏蔽，0.01–0.99 进入门卫。
# Owner 显式邀请使用独立的两轮 / 10 分钟许可。
BOT_REPLY_THRESHOLD=0.85
# 仅覆盖 BOT_QQ_IDS 中的账号；/admin 保存的配置优先。
HAKIMI_BOT_REPLY_THRESHOLDS={}
# /bot-interact no longer bypasses the blacklist. Remove a bot explicitly to admit it.
HAKIMI_REPLY_THRESHOLD=0.70
HAKIMI_OWNER_REPLY_THRESHOLD=0.55
# Legacy reply compatibility settings above. Incoming conversation uses the hot policy below.
# /admin -> 网关调参与审计 saves encrypted SQLite overrides; higher safety scores block less often.
HAKIMI_MESSAGE_INJECTION_THRESHOLD=0.78
HAKIMI_MESSAGE_UNSAFE_THRESHOLD=0.80
HAKIMI_MESSAGE_REPLY_THRESHOLD=0.42
HAKIMI_MESSAGE_OWNER_INJECTION_THRESHOLD=0.90
HAKIMI_MESSAGE_OWNER_UNSAFE_THRESHOLD=0.90
# Independent strict checks for external sources, media and model output stay unchanged.
HAKIMI_INJECTION_THRESHOLD=0.20
HAKIMI_UNSAFE_THRESHOLD=0.50
# Group smart-reply presets: quiet=0.65, natural=0.42, active=0.28; configured in /admin.
# http | ws_reverse | ws_forward. Reverse WS works with the loopback-published Docker port.
# Docker HTTP/forward WS to a host NapCat: use the protected onebot host-gateway alias.
HAKIMI_ONEBOT_MODE=ws_reverse
HAKIMI_ONEBOT_WEBHOOK_ENABLED=true
HAKIMI_ONEBOT_WS_URL=ws://127.0.0.1:3001/
HAKIMI_ONEBOT_WS_TOKEN=GENERATE_WITH_INIT_ENV
# Reverse: NapCat universal client -> ws://127.0.0.1:12141/ws/onebot
# Remote connections require a TLS reverse proxy and wss://bot.example.com/ws/onebot.
HAKIMI_WS_PING_INTERVAL=25
HAKIMI_WS_PING_TIMEOUT=30
HAKIMI_WS_RPC_TIMEOUT=10
HAKIMI_WS_RECONNECT_MAX=30
HAKIMI_SEND_DELAY_MIN=0.8
HAKIMI_SEND_DELAY_MAX=2.0
HAKIMI_SEND_MAX_CHARS=1800

HAKIMI_QQ_ENABLED=false
HAKIMI_QQ_APP_ID=
HAKIMI_QQ_APP_SECRET=
# Legacy compatibility only. Official QQ OpenIDs cannot prove numeric Owner identity.
HAKIMI_QQ_OWNER_IDS=[]
# Explicitly admitted ordinary private friends; PUBLIC persona only, no management commands.
HAKIMI_QQ_ALLOWED_USERS=[]
HAKIMI_QQ_ALLOWED_GROUPS=[]
# Legacy compatibility flag only; unsolicited delivery now requires numeric OWNER_QQ_ID
# over OneBot. Official QQ OpenIDs never receive proactive DMs, even if this is true.
HAKIMI_QQ_ALLOW_PROACTIVE=false
# Deprecated compatibility input, ignored: allowlisted groups admit every non-blocked member.
# Private allowed_users never restricts members of an allowlisted group.
HAKIMI_ALLOW_GROUP_MEMBERS=true
# Group keys are platform:id; unspecified groups default to at_only (address/reply/video).
# Example: {"onebot:123456":"smart_reply","qq:group-openid":"muted"}
HAKIMI_GROUP_POLICIES={}
# Durable session debounce; @/verified reply/private use 0.6s, ordinary groups 2s.
# Incomplete lead-ins wait for a picture (2.2s/3s). Hard cap: 5s or SIX messages.
# Fixed slash commands and licensed external Bots remain standalone. Both GROUP values
# set to 0 disables debounce. Environment changes require restarting only hakimi-bot.
HAKIMI_MENTION_DEBOUNCE_SECONDS=0.6
HAKIMI_MENTION_INCOMPLETE_SECONDS=2.2
HAKIMI_ORDINARY_INCOMPLETE_SECONDS=3.0
HAKIMI_GROUP_DEBOUNCE_SECONDS=2.0
HAKIMI_GROUP_DEBOUNCE_MAX_SECONDS=5.0
# Legacy migration / minimum capacity only; active windows use compression settings above.
HAKIMI_SESSION_TURNS=20
HAKIMI_SESSION_DEFAULT_ENABLED=true
HAKIMI_SESSION_MAX_FILES=1000
HAKIMI_IMAGES_ENABLED=true
HAKIMI_IMAGE_MAX_BYTES=16777216
HAKIMI_IMAGE_MAX_PIXELS=50000000
HAKIMI_IMAGE_STANDARD_MAX_EDGE=1600
HAKIMI_IMAGE_TALL_MAX_EDGE=2560
# Conservative token reservation per image per call; real usage settles the ledger.
HAKIMI_IMAGE_TOKEN_RESERVE=8192

HAKIMI_DAILY_USD=2.00
# UTC billing periods. /admin can hot-save daily/monthly caps; 0 pauses paid work.
# Existing HAKIMI_TOTAL_USD is still an independent lifetime conservative cap.
HAKIMI_MONTHLY_USD=40.00
HAKIMI_USER_DAILY_USD=1.00
HAKIMI_PATROL_DAILY_USD=0.50
# Global generation model: hydrogen | neon | carbon. The admin console can override it.
# Decisions uses its own fixed safety model.
HAKIMI_PRIMARY_MODEL=hydrogen
HAKIMI_NEON_INPUT_USD_PER_M=3
HAKIMI_NEON_CACHED_INPUT_USD_PER_M=0.15
HAKIMI_NEON_OUTPUT_USD_PER_M=15
HAKIMI_OWNER_THINKING_LEVEL=auto
HAKIMI_SUMMARY_THINKING_LEVEL=medium
HAKIMI_DIARY_THINKING_LEVEL=medium
# Above three levels can be set to high; owner-private /deep selects high for one request.
# Caps include thinking tokens. High uses HIGH_OUTPUT_TOKENS in every high scenario.
HAKIMI_CHAT_OUTPUT_TOKENS=1536
HAKIMI_OWNER_OUTPUT_TOKENS=4096
HAKIMI_SUMMARY_OUTPUT_TOKENS=4096
HAKIMI_DIARY_OUTPUT_TOKENS=4096
HAKIMI_HIGH_OUTPUT_TOKENS=8192
# Standard Hydrogen pricing for requests using that model.
HAKIMI_CHAT_INPUT_USD_PER_M=1.50
HAKIMI_CHAT_CACHED_INPUT_USD_PER_M=0.075
HAKIMI_CHAT_OUTPUT_USD_PER_M=7.50
# Cache discount is an observed usage estimate, not a reduction of the conservative fuse.
HAKIMI_USER_REQUESTS_PER_MINUTE=6
HAKIMI_GLOBAL_REQUESTS_PER_MINUTE=30
HAKIMI_BILIBILI_ENABLED=true
HAKIMI_PATROL_INTERVAL_SECONDS=1800
# Independent Bili account patrol: off until you supply a SMALL account's cookies and enable it.
# /admin -> B站小号巡逻配置 stores encrypted hot overrides; cookie values are never returned.
# No auto comments/danmu/DM/follows; likes/favorites also default off and require admin opt-in.
BILI_AUTONOMOUS_ENABLED=false
BILI_SESSDATA=
BILI_BILI_JCT=
BILI_BUVID3=
# Optional: when absent with SESSDATA + bili_jct, fetch once from the official SPI endpoint.
# Auto-filled values are encrypted in SQLite; failures never trigger CAPTCHA bypass or retries.
BILI_BUVID4=
# Optional deployment proxy; no automatic proxy rotation or risk-control bypass.
BILI_PROXY=
# Subtitle-first analysis; optional video fallback is independent of autonomous account patrol.
# /admin -> B站小号 can hot-save these limits to SQLite. Disabled by default.
# Files are <=80 MiB, 360p/480p MP4; local and remote files are cleaned after each attempt.
ENABLE_VIDEO_FILE_WATCH=false
# Allowed range 30..900 seconds; longer videos remain text-only.
MAX_VIDEO_WATCH_SECONDS=900
# Shared across chats and patrol. Use 0 to pause, 1..20 for a daily cap, or unlimited.
DAILY_VIDEO_WATCH_LIMIT=3
HAKIMI_MEMORY_TTL_SECONDS=86400
# Legacy memory table only; new sessions use per-kind compression settings.
HAKIMI_MEMORY_TURNS=4

# The local diary and Drive service load on startup. A folder plus matching credentials authorizes uploads.
# Both modes request only drive.file.
# service_account: share only a Shared Drive subfolder with the dedicated SA.
# oauth: personal My Drive; run scripts/authorize_drive.py to create/bind its own folder.
# Enable Drive API in a dedicated GCP project. The notebook stays independently disabled.
# Permission for allowlisted chat transcripts and existing Owner backup/mirror exports.
# Existing HAKIMI_ROAMING_ENABLED is accepted as an alias. Public diary entries need no grant.
HAKIMI_ARCHIVE_AUTHORIZED_DATA=false
GDRIVE_AUTH_MODE=service_account
GDRIVE_ROAMING_FOLDER_ID=
GDRIVE_SERVICE_ACCOUNT_FILE=/run/secrets/roaming-service-account.json
GDRIVE_OAUTH_CREDENTIALS_FILE=/run/secrets/roaming-oauth.json
HAKIMI_ROAMING_TIMEZONE=Asia/Shanghai
HAKIMI_ROAMING_INTERVAL_SECONDS=7200
# Initial opt-ins for per-group memory mirrors.
HAKIMI_ROAMING_GROUP_IDS=[]
HAKIMI_ROAMING_MAX_EVENTS_PER_DAY=200
# One screened daily summary at 23:55 (or catch-up after restart), charged to patrol.
# Daytime two-hour uploads remain deterministic. Summary results/attempts survive retries.

# Offshore backend: use one >=32-character random token, shared ONLY with NapCat.
# Example generation (run locally, never paste its result into chat):
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
# ONEBOT_ACCESS_TOKEN takes precedence over legacy HAKIMI_ONEBOT_WS_TOKEN when present.
# For an existing deployment, copy its strong existing WS token instead of rotating blindly.
# ONEBOT_ACCESS_TOKEN=GENERATE_A_STRONG_RANDOM_TOKEN
# Set the SAME path in Nginx's exact location and the domestic node's wss URL.
# python -c 'import secrets; print("/ws/onebot/" + secrets.token_hex(24))'
ONEBOT_WS_PATH=/ws/onebot
# Trust X-Real-IP only from explicit immediate reverse proxies. For host Nginx through Docker,
# add this project's Docker bridge gateway address (inspect it; do not trust all private ranges).
ONEBOT_TRUSTED_PROXY_IPS=["127.0.0.1","::1"]
HAKIMI_WS_MAX_FRAME_BYTES=16777216

# Phase 3: Reverse WSS trunk to domestic node_agent (<= 1 MiB frames, no raw media over WS).
# Generate a >=32-char token and secret path suffix locally (never paste secrets into chat):
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
# python -c 'import secrets; print("/ws/node/" + secrets.token_hex(24))'
NODE_WS_ENABLED=false
# NODE_WS_TOKEN=GENERATE_A_STRONG_RANDOM_TOKEN
NODE_WS_PATH=/ws/node
NODE_ID=shanghai-cn-1
NODE_WS_MAX_FRAME_BYTES=1048576
NODE_WS_RPC_TIMEOUT=15.0
NODE_BILI_DELEGATE_ENABLED=true
NODE_BILI_FALLBACK_LOCAL=true
TZ=Asia/Shanghai

# v0.9: A/B/C prefix history; counts below are local estimates, not billed token usage.
HAKIMI_PREFIX_HISTORY_ENABLED=true
# 1.1.4：仅启用记忆的非沙盒主对话允许云端保存与差量续链。
# 关闭后每轮仍由本地完整上下文驱动；后台任务和沙盒始终 store=False。
HAKIMI_INTERACTION_STORE_ENABLED=true
HAKIMI_INTERACTION_CHAIN_TTL_SECONDS=300
HAKIMI_HISTORY_HIGH_TOKENS=28000
HAKIMI_HISTORY_MAX_BYTES=144000
HAKIMI_CHAT_TAIL_TOKENS=4200
HAKIMI_DECISION_INPUT_TOKENS=4200
HAKIMI_FAST_CHAT_THINKING_LEVEL=auto
HAKIMI_CARBON_MODEL=gemini-4-carbon
# Promo through 2026-11-30 UTC; standard prices switch on 2026-12-01 UTC.
HAKIMI_CARBON_INPUT_USD_PER_M=2.00
HAKIMI_CARBON_CACHED_INPUT_USD_PER_M=0.10
HAKIMI_CARBON_OUTPUT_USD_PER_M=10.00
HAKIMI_CARBON_REGULAR_INPUT_USD_PER_M=4.00
HAKIMI_CARBON_REGULAR_CACHED_INPUT_USD_PER_M=0.20
HAKIMI_CARBON_REGULAR_OUTPUT_USD_PER_M=20.00

# v1.0: local asynchronous dual-memory archive (BOT_TIMEZONE, default Asia/Shanghai).
# Manual archive takes a readonly snapshot; neither path slides B for compression.
HAKIMI_MEMORY_ARCHIVE_TIME=03:10
HAKIMI_MEMORY_FLEX_TIMEOUT=900
# Existing HAKIMI_MEMORY_DAILY_USD defaults to 0.20 and includes source/output screening.
# Existing HAKIMI_ROAMING_GROUP_IDS provides initial explicit group mirror opt-ins.
# /admin stores per-group overrides; private memory is never exported.

# v1.1：/admin → 防抖与联网，可持久化热覆盖，恢复时回到启动值。
# 原 HAKIMI_*DEBOUNCE* / *INCOMPLETE_SECONDS 配置仍有效，范围均为 0–30 秒。
# Google Search 与历史/快照隔离；关闭时不发起检索请求。
HAKIMI_WEB_SEARCH_ENABLED=false
HAKIMI_WEB_SEARCH_DAILY_LIMIT=10
HAKIMI_WEB_SEARCH_DAILY_USD=0.50

# 定点天气由对话、其他模块或后台按需查询。
# 经纬度是初始值。在后台「功能模块 → 天气观测」保存的地点优先，可随时恢复环境默认。
HAKIMI_WEATHER_ENABLED=false
# HAKIMI_WEATHER_LATITUDE=
# HAKIMI_WEATHER_LONGITUDE=

# Optional cross-platform voice-message replies via hakimi-voice-gateway (POST /v1/tts).
VOICE_REPLY_ENABLED=false
# owner_only | allowlist | all
VOICE_REPLY_MODE=owner_only
VOICE_REPLY_ALLOWED_GROUPS=[]
# Internal Docker service URL (e.g. http://hakimi-voice-gateway:12145) or https://...
VOICE_GATEWAY_URL=
VOICE_GATEWAY_TOKEN=
VOICE_REPLY_TIMEOUT_SECONDS=12.0
VOICE_REPLY_MAX_CHARS=120
VOICE_REPLY_COOLDOWN_SECONDS=30.0
VOICE_REPLY_DAILY_LIMIT=40
